PORT=3001
# Empresas con un tablero público en Greenhouse o Lever; separadas por comas.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# Opcional: respaldo local para migración o modo offline
DATA_FILE=../data/jobs.json

# Supabase (obligatorio para persistencia principal)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# OpenAI (análisis de compatibilidad y generación de propuestas)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
